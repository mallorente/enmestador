# LLM Configuration
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_MODEL_FALLBACK_1=deepseek-v4-flash
LLM_MODEL_FALLBACK_2=qwen3.6-plus
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_SEC=1.0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Directory Paths (inside container)
USER_DATA_DIR=/app/volumes/user_data
STATE_DIR=/app/volumes/state
OUTPUT_DIR=/app/volumes/obsidian_output

# Pipeline Settings
MAX_BOOKMARKS=500
MAX_EXTERNAL_ARTICLES=3
MAX_CONCURRENT=3
HEADLESS=true
SLOW_MO=0
LOG_LEVEL=INFO

# Fetch Settings
FETCH_TIMEOUT=30.0
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_BASE=1.0
MAX_REDIRECTS=5

# Lock Settings
LOCK_STALE_HOURS=4.0